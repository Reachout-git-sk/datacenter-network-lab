    {
      "id": 7,
      "type": "state-timeline",
      "title": "Fabric link state (spine-leaf)",
      "description": "Operational state of each spine-leaf link (DOWN if either end is down)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "min by (link) (dclab_interface_oper_up{kind=\"fabric\"})",
          "legendFormat": "{{link}}",
          "refId": "A"
        }
      ],
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.85,
        "legend": {
          "showLegend": false
        },
        "alignValue": "center"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
